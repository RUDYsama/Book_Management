# ========================================================
# Lab 9.6: Environment Variables Template (.env.example)
# This template defines all required environment variables
# without exposing actual secrets. Safe to commit to Git.
# ========================================================

# Django Core Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
PORT=8000

# Database Configuration
# Local: sqlite3 (DB_HOST left blank)
# Cloud Production: mysql (Fill in Aiven credentials)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
DB_SSL_REQUIRED=false

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Email Service Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Book Store <noreply@example.com>

# Frontend & CORS Configuration (Lab 9.6 & 9.7)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
